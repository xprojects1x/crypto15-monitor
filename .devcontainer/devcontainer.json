{
  "name": "BTC 15-min monitor",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --quiet -r requirements.txt",
  "postAttachCommand": "bash cloud_start.sh",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "BTC monitor dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
